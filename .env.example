# URL of your deployed Vercel production project (no trailing slash).
APP_BASE_URL=https://your-project.vercel.app
# Generate the following using: python scripts/make_secrets.py
ADMIN_PASSWORD_HASH=REPLACE_WITH_SCRYPT_HASH
DATA_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
# Upstash Redis REST credentials (use the regular token, NOT the readonly token).
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=REPLACE_WITH_UPSTASH_TOKEN

# Optional mailbox OAuth providers. Configure confidential Web applications first.
# Callback: APP_BASE_URL/oauth/mail/google/callback
# Leave empty until you have your own provider application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callback: APP_BASE_URL/oauth/mail/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# common supports both personal and work accounts only if app registration allows them.
MICROSOFT_TENANT_ID=common
